<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../FerrumPix.vbproj" />
    <Content Include="Fixtures/calibration-legacy.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/full-basic-legacy.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/curves-legacy.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/late-color-legacy.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/hsl-point-legacy.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/rendered-input-legacy.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/spatial-legacy.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- LibRaw is dynamically loaded, so ProjectReference cannot discover this optional native
       dependency. Reuse the application's binary when present rather than testing a JPEG fallback. -->
  <Target Name="CopyRawDecoderForProbe" AfterTargets="Build">
    <ItemGroup>
      <RawDecoder Include="../../bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/libraw*"
                  Exclude="../../bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(RawDecoder)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
